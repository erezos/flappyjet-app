<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ✅ Push Notifications (APNs) -->
	<!-- Required for daily streak reminders and tournament notifications -->
	<key>aps-environment</key>
	<string>production</string>
	
	<!-- Note: For development/testing, Xcode will automatically switch this to "development" -->
	<!-- For App Store builds, this must be "production" -->
</dict>
</plist>

